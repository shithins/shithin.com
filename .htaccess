# shithin.com — Hostinger (LiteSpeed/Apache)
#
# Static site: six generated pages, one stylesheet, one script and a forest
# image family. No server-side processing, no external runtime dependencies.
#
# The staging X-Robots-Tag block that used to live here was removed when this
# design was promoted to the main domain.

# MIME types (Hostinger's defaults miss webp on some plans).
AddType image/webp .webp
AddType image/svg+xml .svg

<IfModule mod_expires.c>
  ExpiresActive On
  # Artwork is content-addressed by name and changes only on rebuild.
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  # The stylesheet and script are NOT hashed, so keep them short-lived or a
  # returning visitor keeps a stale design after a deploy.
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpg|jpeg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
